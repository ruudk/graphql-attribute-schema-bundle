{
    "name": "jerowork/graphql-attribute-schema-bundle",
    "description": "Symfony bundle for jerowork/graphql-attribute-schema. Auto-builds a compile-time service locator from #[Autowire] usages on resolver methods.",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "graphql",
        "webonyx",
        "attributes",
        "symfony",
        "bundle"
    ],
    "authors": [
        {
            "name": "Jeroen de Graaf",
            "email": "hello@jero.work",
            "homepage": "https://jero.work"
        }
    ],
    "require": {
        "php": "^8.4",
        "jerowork/graphql-attribute-schema": "^0.7",
        "symfony/config": "^8.0",
        "symfony/dependency-injection": "^8.0",
        "symfony/http-kernel": "^8.0",
        "webonyx/graphql-php": "^15.32"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "psr/container": "^2.0",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "symfony/cache": "^8.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/routing": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "Jerowork\\GraphqlAttributeSchemaBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jerowork\\GraphqlAttributeSchemaBundle\\Test\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "phpstan": "vendor/bin/phpstan analyse -c phpstan.neon",
        "phpunit": "vendor/bin/phpunit",
        "dependency-analyser": "vendor/bin/composer-dependency-analyser",
        "test": [
            "@phpstan",
            "@dependency-analyser",
            "@phpunit"
        ]
    }
}
